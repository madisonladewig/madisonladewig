@page "/itineraries"
<PageTitle>Itineraries</PageTitle>
@rendermode InteractiveServer

@using eToursSystem.BLL;
@using eToursSystem.Entities;

<h1>Itineraries</h1>

@if (!string.IsNullOrWhiteSpace(feedBackMsg))
{
    <div class="alert alert-info">
        <p>@feedBackMsg</p>
    </div>
}

<label for="tourselect">
    Select Tour:
</label>
<select id="tourselect" @bind="tourid">
    <option value="0">... select ...</option>
    @foreach (var row in tourInfo)
    {
        <option value="@row.TourID">
            @row.Name
        </option>
    }
</select>

<br />
<button type="submit" @onclick="RTP" class="btn btn-outline-primary rounded-pill" style="width:250px;">Fetch Itinerary</button>
&nbsp;&nbsp;
<button type="submit" @onclick="New" class="btn btn-outline-secondary rounded-pill" style="width:250px;">Add new Destination</button>

<br />
<br />
@if (destinationInfo != null)
    if (destinationInfo.Count() == 0)
    {
        <p style="color:firebrick;font-weight:bold">
            No destinations found for this tour.
        </p>
    }
    else
    {
        <div class="row">
            <div class="offset-3 col-md-6">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Location</th>
                            <th>Country</th>
                            <th>Date</th>
                            <th>Stay Hours</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in destinationInfo)
                        {
                            <tr>
                                <td>@item.DestinationID</td>
                                <td>@item.Location</td>
                                <td>@item.Country</td>
                                <td>@item.VisitDate.ToString("yyyy-MMM-dd")</td>
                                <td>@item.StayDuration</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
@code {
    private string feedBackMsg = "";
    private int tourid;

    [Inject]
    private TourServices _tourServices { get; set; }
    private List<Tour> tourInfo = new List<Tour>();

    [Inject]
    private DestinationServices _destinationServices { get; set; }
    private List<Destination> destinationInfo;

    [Inject]
    private NavigationManager _navManager { get; set; }

    protected override void OnInitialized()
    {
        tourInfo = _tourServices.Tour_GetList();
        base.OnInitialized();
    }

    public Exception GetInnerException(Exception ex)
    {
        while (ex.InnerException != null)
        {
            ex = ex.InnerException;
        }
        return ex;
    }

    private void RTP ()
    {
        if (tourid == 0)
        {
            feedBackMsg = "Select a tour to view";
        }
        else
        {
            try
            {
                destinationInfo = _destinationServices.Destination_GetByTour(tourid);
            }
            catch(Exception ex)
            {
                feedBackMsg = $"System Error: {GetInnerException(ex).Message}";
            }
        }
    }
    private void New()
    {
        _navManager.NavigateTo("destinationcrud");
    }
}
